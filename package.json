{
  "name": "groups-commons",
  "version": "0.1.0",
  "private": true,
  "description": "Prototype: a shared commons of reusable organizing materials for AI safety university groups.",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node server/index.js",
    "dev": "STORE=local PORT=8787 node server/index.js",
    "test": "node --test test/*.test.js",
    "test:pg": "STORE=pg PG_TEST=pglite node --test test/*.test.js",
    "test:pg:server": "STORE=pg PG_TEST=server node --test --test-concurrency=2 test/*.test.js"
  },
  "dependencies": {
    "@google-cloud/cloud-sql-connector": "^1.13.0",
    "@google-cloud/firestore": "^7.11.0",
    "@google-cloud/storage": "^7.15.0",
    "compression": "^1.8.1",
    "express": "^4.21.2",
    "google-auth-library": "^9.15.0",
    "pg": "^8.23.1"
  },
  "optionalDependencies": {
    "sharp": "^0.35.5"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16"
  }
}
